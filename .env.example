# ============================================
# Shinoo - Backend Environment Variables
# ============================================
# Copy this file to backend/.env and fill in with your actual values

# ============================================
# Server Configuration
# ============================================
# Environment type: development or production
NODE_ENV=development

# Server port
PORT=3000

# ============================================
# Database Configuration
# ============================================
# MongoDB connection string
# Format: mongodb+srv://username:password@host/database?retryWrites=true&w=majority
# Get from: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/shinoo?retryWrites=true&w=majority

# ============================================
# Authentication (JWT)
# ============================================
# Secret key for JWT token signing
# Generate a long, random string (min 32 characters recommended)
# Keep this secure and unique per environment
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters_recommended

# ============================================
# Frontend URL (CORS Configuration)
# ============================================
# Frontend origin for Cross-Origin Resource Sharing
# Development: http://localhost:5173 (Vite default)
# Production: https://your-domain.com (your deployed domain)
CLIENT_URL=http://localhost:5173

# ============================================
# Cloudinary Configuration (Image Upload)
# ============================================
# Cloudinary cloud name
# Get from: https://cloudinary.com > Dashboard > Account Settings
CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary API key
# Get from: https://cloudinary.com > Dashboard > API Keys
CLOUDINARY_API_KEY=your_api_key

# Cloudinary API secret
# Get from: https://cloudinary.com > Dashboard > API Keys
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# Arcjet Configuration (Rate Limiting & Bot Detection)
# ============================================
# Arcjet API key for security middleware
# Get from: https://arcjet.com > Dashboard > API Keys
# Provides:
#   - Rate limiting (100 requests/60s default)
#   - Bot detection
#   - Shield protection (SQL injection, XSS prevention)
ARCJET_KEY=ajk_your_arcjet_key_here

# ============================================
# Optional: Additional Configuration
# ============================================
# Add any additional environment variables here
# Examples:
# REDIS_URL=redis://localhost:6379
# SMTP_HOST=smtp.gmail.com
# ADMIN_EMAIL=admin@example.com

# ============================================
# Notes:
# ============================================
# - Never commit .env to version control
# - Use .env.example as a template for team members
# - Keep sensitive values secure (use secrets manager in production)
# - Different values for development and production environments
